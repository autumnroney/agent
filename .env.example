# Get a free key at https://fredaccount.stlouisfed.org/apikeys
# Set this in Netlify: Site configuration -> Environment variables
FRED_API_KEY=your_32_character_fred_api_key_here

# Get a free key at https://data.bls.gov/registrationEngine/
# Set this in Netlify: Site configuration -> Environment variables, then redeploy
# Never put a real key in this file.
BLS_API_KEY=your_bls_registration_key_here
